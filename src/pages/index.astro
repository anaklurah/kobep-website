---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import Pagination from '../components/Pagination.astro';
import { getDb } from '../lib/db';

export const prerender = false;

const db = getDb();
const settings = db.settings;
const allVideos = db.videos;

// Pagination
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);
const pageSize = 12;
const totalPages = Math.ceil(allVideos.length / pageSize) || 1;
const startIndex = (page - 1) * pageSize;
const paginatedVideos = allVideos.slice(startIndex, startIndex + pageSize);
---

<Layout>
  <div class="container mx-auto px-4 py-3">
    <!-- Search Bar (Desktop only, mobile view search bar is inside Navbar) -->
    <div class="hidden md:block">
      <SearchBar />
    </div>

    <!-- Top Header Ad Banner -->
    <AdBanner position="header" />

    <!-- Site Welcome / Heading Header -->
    <div class="my-6 border-b border-gray-800/80 pb-4 flex flex-col md:flex-row md:items-end justify-between gap-2">
      <div>
        <h1 class="text-xl md:text-2xl font-black text-white tracking-tight flex items-center gap-2">
          <span>{settings.siteName}</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-primary/20 text-primary border border-primary/30 font-semibold uppercase">Update Harian</span>
        </h1>
        <p class="text-xs md:text-sm text-gray-400 mt-1">
          {settings.tagline}
        </p>
      </div>
      <div class="text-xs text-gray-500 font-mono">
        Total {allVideos.length} Koleksi Video
      </div>
    </div>

    <!-- Video Grid -->
    <div class="mb-8">
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-3 gap-y-6 md:gap-x-4 md:gap-y-6 lg:gap-x-5 lg:gap-y-7">
        {paginatedVideos.map((video, idx) => (
          <>
            <VideoCard video={video} />
            {/* Insert in-feed ad banner after the 4th video */}
            {idx === 3 && (
              <li class="col-span-2 md:col-span-3 lg:col-span-4 my-2">
                <AdBanner position="grid_middle" />
              </li>
            )}
          </>
        ))}
      </ul>
    </div>

    <!-- Bottom Ad Banner -->
    <AdBanner position="watch_bottom" />

    <!-- Pagination -->
    <Pagination currentPage={page} totalPages={totalPages} totalItems={allVideos.length} />
  </div>
</Layout>
