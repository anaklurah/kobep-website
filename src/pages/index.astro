---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import SearchBar from '../components/SearchBar.astro';
import AdBanner from '../components/AdBanner.astro';
import Pagination from '../components/Pagination.astro';
import { getDb } from '../lib/db';

export const prerender = false;

const db = getDb();
const settings = db.settings;
const allVideos = db.videos;
const categories = db.categories;

// Pagination
const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);
const pageSize = 12;
const totalPages = Math.ceil(allVideos.length / pageSize) || 1;
const startIndex = (page - 1) * pageSize;
const paginatedVideos = allVideos.slice(startIndex, startIndex + pageSize);
---

<Layout>
  <div class="container mx-auto px-4 py-3">
    <!-- Search Bar (Desktop only, mobile view search bar is inside Navbar) -->
    <div class="hidden md:block">
      <SearchBar />
    </div>

    <!-- Top Header Ad Banner -->
    <AdBanner position="header" />

    <!-- Category Filter Chips (Horizontal Scrollable Bar) -->
    <div class="my-3 -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-xs">
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-primary text-white font-semibold shadow-md shadow-primary/30 shrink-0 text-xs transition-all active:scale-95"
        >
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>Semua Video</span>
        </a>

        <a 
          href="/trending" 
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold shrink-0 text-xs transition-all active:scale-95"
        >
          <svg class="w-3 h-3 fill-current text-amber-400" viewBox="0 0 24 24">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
          </svg>
          <span>Trending</span>
        </a>

        {categories.map((cat) => (
          <a 
            href={`/category/${cat.slug}`}
            class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#0d121c] hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800/90 hover:border-slate-700 font-medium shrink-0 text-xs transition-all active:scale-95"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Section Header (Clean Streaming Layout) -->
    <div class="flex items-center justify-between gap-3 pt-3 pb-3 border-b border-slate-800/70 mb-5">
      <div class="flex items-center gap-2.5">
        <span class="w-1.5 h-5 rounded-full bg-gradient-to-b from-primary to-purple-400 shrink-0"></span>
        <div>
          <h1 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
            <span>Video Terbaru & Viral</span>
          </h1>
          <p class="text-[11px] sm:text-xs text-slate-400 mt-0.5">
            {settings.tagline || 'Streaming video kualitas HD terlengkap diperbarui setiap hari'}
          </p>
        </div>
      </div>

      <!-- Live Counter Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-slate-400 text-xs font-medium shrink-0 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-slate-200 font-semibold">{allVideos.length}</span>
        <span class="hidden xs:inline">Video</span>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="mb-8">
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-3 gap-y-6 md:gap-x-4 md:gap-y-6 lg:gap-x-5 lg:gap-y-7">
        {paginatedVideos.map((video, idx) => (
          <>
            <VideoCard video={video} />
            {/* Insert in-feed ad banner after the 4th video */}
            {idx === 3 && (
              <li class="col-span-2 md:col-span-3 lg:col-span-4 my-2">
                <AdBanner position="grid_middle" />
              </li>
            )}
          </>
        ))}
      </ul>
    </div>

    <!-- Bottom Ad Banner -->
    <AdBanner position="watch_bottom" />

    <!-- Pagination -->
    <Pagination currentPage={page} totalPages={totalPages} totalItems={allVideos.length} />
  </div>
</Layout>
