---
import Layout from '../../layouts/Layout.astro';
import VideoCard from '../../components/VideoCard.astro';
import AdBanner from '../../components/AdBanner.astro';
import { getDb } from '../../lib/db';
import { formatNumber } from '../../lib/color';

export const prerender = false;

const { slug } = Astro.params;
const db = getDb();

const video = db.videos.find((v) => v.slug === slug || v.id === slug);

if (!video) {
  return Astro.redirect('/?error=video_not_found');
}

// Increment view count in SSR
video.views = (video.views || 0) + 1;
db.analytics.totalViews = (db.analytics.totalViews || 0) + 1;
const today = new Date().toISOString().slice(0, 10);
if (!db.analytics.dailyViews) db.analytics.dailyViews = {};
db.analytics.dailyViews[today] = (db.analytics.dailyViews[today] || 0) + 1;

// Get related videos (same category or similar, excluding current video)
const relatedVideos = db.videos
  .filter((v) => v.id !== video.id)
  .sort((a, b) => (a.category === video.category ? -1 : 1))
  .slice(0, 9);

// Get top trending videos for sidebar
const topTrendingVideos = db.videos
  .filter((v) => v.id !== video.id)
  .sort((a, b) => b.views - a.views)
  .slice(0, 6);

const isEmbed = video.videoUrl.includes('embed') || video.videoUrl.includes('iframe') || video.videoUrl.includes('eporner.com');
---

<Layout 
  title={video.title} 
  description={video.description || video.title}
  ogImage={video.thumbUrl}
  ogType="video.other"
>
  <div class="container mx-auto px-4 py-4 max-w-6xl">
    <!-- Top Banner Ad -->
    <AdBanner position="watch_top" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-2">
      <!-- Main Content: Video Player & Details & Rekomendasi Video -->
      <div class="lg:col-span-2">
        <!-- Video Player Wrapper -->
        <div class="w-full bg-black rounded-xl overflow-hidden border border-gray-800 shadow-2xl relative aspect-video">
          {isEmbed ? (
            <iframe 
              src={video.videoUrl} 
              allowfullscreen 
              allow="autoplay; fullscreen"
              class="w-full h-full border-0"
            ></iframe>
          ) : (
            <video 
              id="main-video-player"
              controls 
              playsinline 
              poster={video.thumbUrl}
              preload="metadata"
              class="w-full h-full object-contain"
            >
              <source src={video.videoUrl} type="video/mp4" />
              Browser Anda tidak mendukung tag video HTML5.
            </video>
          )}
        </div>

        <!-- Player Enhanced Controls Bar (for direct video stream) -->
        {!isEmbed && (
          <div class="flex flex-wrap items-center justify-between gap-2 mt-2 px-3 py-2 bg-slate-900/90 rounded-lg border border-slate-800 text-xs">
            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                id="rewind-10-btn"
                class="flex items-center gap-1 px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono font-semibold transition-colors cursor-pointer"
                title="Mundur 10 Detik"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
                <span>-10s</span>
              </button>

              <button 
                type="button" 
                id="forward-10-btn"
                class="flex items-center gap-1 px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono font-semibold transition-colors cursor-pointer"
                title="Maju 10 Detik"
              >
                <span>+10s</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                  <path d="M21 3v5h-5"></path>
                </svg>
              </button>
            </div>

            <div class="flex items-center gap-2">
              <label for="speed-select" class="text-[11px] text-slate-400 font-medium hidden sm:inline">Kecepatan:</label>
              <select 
                id="speed-select" 
                class="bg-slate-800 border border-slate-700 rounded px-2 py-1 text-xs text-white focus:outline-none focus:border-primary font-mono cursor-pointer"
              >
                <option value="0.75">0.75x</option>
                <option value="1.0" selected>1.0x Normal</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
                <option value="2.0">2.0x</option>
              </select>

              <a 
                href={video.videoUrl} 
                download 
                target="_blank"
                class="flex items-center gap-1 px-2.5 py-1 rounded bg-primary/20 hover:bg-primary text-primary hover:text-white border border-primary/40 text-xs font-semibold transition-all"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Unduh MP4</span>
              </a>
            </div>
          </div>
        )}

        <!-- Video Info Header -->
        <div class="mt-4 pb-4 border-b border-gray-800">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <a 
              href={`/category/${encodeURIComponent(video.category.toLowerCase().replace(/\s+/g, '-'))}`}
              class="text-xs px-2.5 py-1 rounded-md bg-primary/20 text-primary border border-primary/30 font-semibold uppercase tracking-wider hover:bg-primary hover:text-white transition-colors"
            >
              {video.category}
            </a>
            <span class="text-xs text-gray-500">•</span>
            <span class="text-xs text-gray-400">
              {new Date(video.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          </div>

          <h1 class="text-lg md:text-xl font-bold text-white leading-snug">
            {video.title}
          </h1>

          <!-- Stats & Interaction Bar -->
          <div class="flex flex-wrap items-center justify-between gap-4 mt-3 pt-3 border-t border-gray-800/60">
            <div class="flex items-center gap-4 text-xs text-gray-400">
              <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <strong class="text-gray-200">{formatNumber(video.views)}</strong> kali ditonton
              </span>
              <span>•</span>
              <span class="font-mono text-gray-400">Durasi: {video.duration}</span>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2">
              <button 
                id="like-btn" 
                data-video-id={video.id}
                class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-gray-900 hover:bg-gray-800 text-gray-200 hover:text-red-400 border border-gray-700/60 text-xs font-semibold transition-all cursor-pointer group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500 group-hover:scale-110 transition-transform fill-current" viewBox="0 0 24 24">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                <span>Suka (<span id="likes-count">{video.likes}</span>)</span>
              </button>

              <button 
                id="share-btn"
                class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-gray-900 hover:bg-gray-800 text-gray-200 hover:text-primary border border-gray-700/60 text-xs font-semibold transition-all cursor-pointer"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
                <span>Bagikan</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Description Box -->
        {video.description && (
          <div class="mt-4 p-4 rounded-xl bg-gray-950/70 border border-gray-800/80 text-xs md:text-sm text-gray-300 leading-relaxed">
            <h4 class="font-semibold text-white mb-1.5 flex items-center gap-1.5">
              <span>Deskripsi Video</span>
            </h4>
            <p class="whitespace-pre-line text-gray-400">{video.description}</p>
          </div>
        )}

        <!-- Bottom Watch Ad Banner -->
        <AdBanner position="watch_bottom" className="my-6" />

        <!-- Bagian Rekomendasi Video Menggantikan Komentar -->
        <section class="mt-8 pt-6 border-t border-gray-800">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-base md:text-lg font-bold text-white flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>Rekomendasi Video Terkait ({relatedVideos.length})</span>
            </h3>
            <a 
              href={`/category/${encodeURIComponent(video.category.toLowerCase().replace(/\s+/g, '-'))}`}
              class="text-xs text-primary hover:underline font-semibold"
            >
              Lihat Semua {video.category} &rarr;
            </a>
          </div>

          <ul class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {relatedVideos.map((item) => (
              <VideoCard video={item} />
            ))}
          </ul>
        </section>
      </div>

      <!-- Sidebar: Paling Banyak Ditonton -->
      <div class="lg:col-span-1">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-gray-800 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>Paling Banyak Ditonton</span>
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-1 gap-3 md:gap-4">
          {topTrendingVideos.map((item) => (
            <VideoCard video={item} />
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Like button handling
  const likeBtn = document.getElementById('like-btn');
  const likesCount = document.getElementById('likes-count');
  let hasLiked = false;

  if (likeBtn && likesCount) {
    likeBtn.addEventListener('click', async () => {
      if (hasLiked) {
        alert('Anda sudah menyukai video ini!');
        return;
      }
      const videoId = likeBtn.getAttribute('data-video-id');
      try {
        const res = await fetch('/api/analytics', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ videoId, action: 'like' })
        });
        const data = await res.json();
        if (data.success && data.likes !== undefined) {
          likesCount.textContent = String(data.likes);
          hasLiked = true;
          likeBtn.classList.add('bg-red-950/40', 'border-red-500/50');
        }
      } catch (err) {
        console.error('Like error:', err);
      }
    });
  }

  // Share button handling
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({
          title: document.title,
          url: window.location.href
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(window.location.href).then(() => {
          alert('Tautan video berhasil disalin ke clipboard!');
        });
      }
    });
  }

  // Enhanced Video Controls (Speed, Skip, Keyboard Shortcuts)
  const videoEl = document.getElementById('main-video-player') as HTMLVideoElement | null;
  const rewindBtn = document.getElementById('rewind-10-btn');
  const forwardBtn = document.getElementById('forward-10-btn');
  const speedSelect = document.getElementById('speed-select') as HTMLSelectElement | null;

  if (videoEl) {
    if (rewindBtn) {
      rewindBtn.addEventListener('click', () => {
        videoEl.currentTime = Math.max(0, videoEl.currentTime - 10);
      });
    }

    if (forwardBtn) {
      forwardBtn.addEventListener('click', () => {
        videoEl.currentTime = Math.min(videoEl.duration || Infinity, videoEl.currentTime + 10);
      });
    }

    if (speedSelect) {
      speedSelect.addEventListener('change', () => {
        videoEl.playbackRate = parseFloat(speedSelect.value) || 1.0;
      });
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      if (['input', 'textarea', 'select'].includes(activeTag)) return;

      if (e.code === 'ArrowLeft') {
        e.preventDefault();
        videoEl.currentTime = Math.max(0, videoEl.currentTime - 10);
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        videoEl.currentTime = Math.min(videoEl.duration || Infinity, videoEl.currentTime + 10);
      } else if (e.code === 'Space') {
        e.preventDefault();
        if (videoEl.paused) videoEl.play();
        else videoEl.pause();
      }
    });
  }
</script>
