              <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/80 text-[10px] font-mono font-semibold text-white">
                ${video.length_min || '04:00'}
              </span>
              <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-primary/80 text-[9px] font-bold text-white uppercase tracking-wider">
                HD
              </span>
            </div>
            <div class="p-3 flex-1 flex flex-col justify-between">
              <div>
                <h4 class="text-xs font-semibold text-white line-clamp-2" title="${safeTitle}">
                  ${safeTitle}
                </h4>
                <div class="flex items-center gap-3 mt-2 text-[10px] text-slate-400">
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    ${viewsFormatted}
                  </span>
                  <span class="flex items-center gap-1 text-amber-400 font-semibold">
                    ${rateFormatted}
                  </span>
                </div>
              </div>
              <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between gap-2">
                <a href="${video.url}" target="_blank" rel="noopener noreferrer" class="text-[10px] text-slate-400 hover:text-primary transition-colors flex items-center gap-1">
                  <span>Asli</span>
                  <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
                <div class="action-slot">
                  ${isImported ? `
                    <button disabled class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 text-[11px] font-semibold border border-emerald-500/30 flex items-center gap-1 cursor-default">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>Tersimpan</span>
                    </button>
                  ` : `
                    <button type="button" class="eporner-single-import-btn px-2.5 py-1.5 rounded-lg bg-primary hover:bg-primary/90 text-white text-[11px] font-semibold transition-all cursor-pointer flex items-center gap-1 shadow" data-id="${video.id}">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                      <span>Import Video</span>
                    </button>
                  `}
                </div>
              </div>
            </div>
          `;

          epornerGrid.appendChild(card);
        });

        // Attach event listener for single import buttons
        const singleBtns = epornerGrid.querySelectorAll('.eporner-single-import-btn');
        singleBtns.forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            const btnEl = e.currentTarget as HTMLButtonElement;
            const vidId = btnEl.getAttribute('data-id');
            const targetVideo = epornerCurrentVideos.find(v => String(v.id) === String(vidId));
            if (!targetVideo) return;

            btnEl.disabled = true;
            btnEl.innerHTML = `
              <div class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white/20 border-t-white"></div>
              <span>Menyimpan...</span>
            `;

            const cat = epornerTargetCat ? epornerTargetCat.value : 'Indo Viral';

            try {
              const res = await fetch('/api/eporner/import', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ videos: [targetVideo], category: cat })
              });
              const data = await res.json();
              if (data.success) {
                targetVideo.isImported = true;
                const slot = btnEl.closest('.action-slot');
                if (slot) {
                  slot.innerHTML = `
                    <button disabled class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 text-[11px] font-semibold border border-emerald-500/30 flex items-center gap-1 cursor-default">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>Tersimpan</span>
                    </button>
                  `;
                }
                updateEpornerBatchButtonState();
                showToast(`Video "${targetVideo.title.slice(0, 30)}..." berhasil di-import!`);
              } else {
                showToast(data.error || 'Gagal mengimpor video', true);
                btnEl.disabled = false;
                btnEl.innerHTML = `
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  <span>Coba Lagi</span>
                `;
              }
            } catch (err) {
              console.error(err);
              showToast('Terjadi kesalahan jaringan saat import', true);
              btnEl.disabled = false;
            }
          });
        });

        updateEpornerBatchButtonState();
      }

      async function executeEpornerSearch(page = 1) {
        const query = epornerQueryInput ? epornerQueryInput.value.trim() : 'indonesia';
        const order = epornerOrderSelect ? epornerOrderSelect.value : 'most-popular';

        epornerCurrentPage = page;
        if (epornerLoading) epornerLoading.classList.remove('hidden');
        if (epornerGrid) epornerGrid.classList.add('hidden');
        if (epornerEmpty) epornerEmpty.classList.add('hidden');
        if (epornerSearchBtn) (epornerSearchBtn as HTMLButtonElement).disabled = true;
        if (epornerSearchBtnText) epornerSearchBtnText.textContent = 'Mencari...';

        try {
          const res = await fetch(`/api/eporner/search?q=${encodeURIComponent(query)}&page=${page}&per_page=24&order=${order}`);
          const data = await res.json();

          if (data.error) {
            showToast(data.error, true);
            if (epornerEmpty) epornerEmpty.classList.remove('hidden');
            return;
          }

          epornerCurrentVideos = data.videos || [];
          epornerTotalPages = data.total_pages || Math.ceil((data.total_count || 0) / 24) || 1;

          if (epornerStatus) {
            epornerStatus.innerHTML = `Ditemukan <strong class="text-white">${(data.total_count || epornerCurrentVideos.length).toLocaleString('id-ID')}</strong> video untuk kata kunci "<span class="text-primary font-medium">${escapeEpornerHtml(query)}</span>"`;
          }

          if (epornerPageIndicator) epornerPageIndicator.textContent = `Hal. ${epornerCurrentPage} dari ${epornerTotalPages}`;
          if (epornerPageInfo) epornerPageInfo.textContent = `Halaman ${epornerCurrentPage} dari ${epornerTotalPages}`;
          if (epornerPaginationTop) epornerPaginationTop.classList.remove('hidden');
          if (epornerPaginationBottom) epornerPaginationBottom.classList.remove('hidden');

          if (epornerPrevBtn) epornerPrevBtn.disabled = epornerCurrentPage <= 1;
          if (epornerNextBtn) epornerNextBtn.disabled = epornerCurrentPage >= epornerTotalPages;

          if (epornerCurrentVideos.length === 0) {
            if (epornerEmpty) epornerEmpty.classList.remove('hidden');
          } else {
            renderEpornerCards(epornerCurrentVideos);
            if (epornerGrid) epornerGrid.classList.remove('hidden');
          }

          epornerHasLoadedOnce = true;
        } catch (err) {
          console.error('Error fetching Eporner videos:', err);
          showToast('Gagal memuat video dari Eporner API', true);
          if (epornerEmpty) epornerEmpty.classList.remove('hidden');
        } finally {
          if (epornerLoading) epornerLoading.classList.add('hidden');
          if (epornerSearchBtn) (epornerSearchBtn as HTMLButtonElement).disabled = false;
          if (epornerSearchBtnText) epornerSearchBtnText.textContent = 'Cari Video';
        }
      }

      // Eporner Search form submit
      if (epornerForm) {
        epornerForm.addEventListener('submit', (e) => {
          e.preventDefault();
          executeEpornerSearch(1);
        });
      }

      // Quick keyword tags click
      epornerQuickTags.forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query');
          if (q && epornerQueryInput) {
            epornerQueryInput.value = q;
            executeEpornerSearch(1);
          }
        });
      });

      // Pagination clicks
      if (epornerPrevBtn) {
        epornerPrevBtn.addEventListener('click', () => {
          if (epornerCurrentPage > 1) {
            executeEpornerSearch(epornerCurrentPage - 1);
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      }

      if (epornerNextBtn) {
        epornerNextBtn.addEventListener('click', () => {
          if (epornerCurrentPage < epornerTotalPages) {
            executeEpornerSearch(epornerCurrentPage + 1);
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      }

      // Batch import button click
      if (epornerBatchBtn) {
        epornerBatchBtn.addEventListener('click', async () => {
          const unimported = epornerCurrentVideos.filter(v => !v.isImported);
          if (unimported.length === 0) {
            showToast('Semua video pada halaman ini sudah di-import.');
            return;
          }

          epornerBatchBtn.disabled = true;
          if (epornerBatchBtnText) epornerBatchBtnText.textContent = `Mengimpor ${unimported.length} Video...`;

          const cat = epornerTargetCat ? epornerTargetCat.value : 'Indo Viral';

          try {
            const res = await fetch('/api/eporner/import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ videos: unimported, category: cat })
            });
            const data = await res.json();
            if (data.success) {
              unimported.forEach(v => {
                v.isImported = true;
                const card = document.getElementById(`eporner-card-${v.id}`);
                if (card) {
                  const slot = card.querySelector('.action-slot');
                  if (slot) {
                    slot.innerHTML = `
                      <button disabled class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 text-[11px] font-semibold border border-emerald-500/30 flex items-center gap-1 cursor-default">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Tersimpan</span>
                      </button>
                    `;
                  }
                }
              });
              updateEpornerBatchButtonState();
              showToast(`Sukses! ${data.count} video berhasil di-import ke kategori "${cat}".`);
            } else {
              showToast(data.error || 'Gagal melakukan import massal', true);
            }
          } catch (err) {
            console.error(err);
            showToast('Terjadi kesalahan saat import massal', true);
          } finally {
            updateEpornerBatchButtonState();
          }
        });
      }

      // Hook tab switching to auto-load Eporner when clicked
      const epornerTabBtn = document.querySelector('button[data-tab="tab-eporner"]');
      if (epornerTabBtn) {
        epornerTabBtn.addEventListener('click', () => {
          if (!epornerHasLoadedOnce) {
            executeEpornerSearch(1);
          }
        });
      }

      // Logout handler
      const adminLogoutBtn = document.getElementById('admin-logout-btn');
      if (adminLogoutBtn) {
        adminLogoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/api/auth/logout', { method: 'POST' });
          } catch (e) {
            console.error(e);
          }
          window.location.href = '/admin/login';
        });
      }
    </script>
  </body>
</html>
