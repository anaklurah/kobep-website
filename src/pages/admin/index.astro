          const safeTitle = escapeEpornerHtml(video.title);
          const isImported = Boolean(video.isImported);
          const viewsFormatted = Number(video.views || 0).toLocaleString('id-ID');
          const rateFormatted = video.rate ? `${video.rate} ★` : '4.8 ★';

          const card = document.createElement('div');
          card.id = `eporner-card-${video.id}`;
          card.className = 'bg-[#0c1017] rounded-xl border border-slate-800/80 overflow-hidden shadow-sm flex flex-col group hover:border-slate-700 transition-all';
          card.innerHTML = `
            <div class="relative aspect-video bg-black overflow-hidden">
