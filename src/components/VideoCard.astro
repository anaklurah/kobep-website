---
import type { Video } from '../lib/db';
import { formatNumber } from '../lib/color';

interface Props {
  video: Video;
}

const { video } = Astro.props;

// Prepare preview thumbs array
let previewList: string[] = [];
if (video.previewThumbs && video.previewThumbs.length > 0) {
  previewList = video.previewThumbs;
} else if (video.thumbUrl && (video.thumbUrl.includes('eporner.com') || video.id.startsWith('ep-'))) {
  // Generate 1-12 frame variations from Eporner pattern
  const match = video.thumbUrl.match(/^(.*\/)(\d+)(_\d+\.(?:jpg|webp))$/);
  if (match) {
    const prefix = match[1];
    const suffix = match[3];
    previewList = Array.from({ length: 12 }, (_, i) => `${prefix}${i + 1}${suffix}`);
  }
}
const hasPreview = previewList.length > 1;
---

<li class="video-card group">
  <a href={`/view/${video.slug}`} title={video.title} class="block">
    <div 
      class={`videos-card-wrapper relative mb-2.5 overflow-hidden rounded-xl border border-slate-800/80 group-hover:border-primary/50 group-hover:shadow-lg group-hover:shadow-primary/10 transition-all duration-300 ${hasPreview ? 'storyboard-card' : ''}`}
      data-default-thumb={video.thumbUrl}
      data-preview-thumbs={hasPreview ? JSON.stringify(previewList) : ''}
    >
      <!-- Thumbnail Image -->
      <img 
        src={video.thumbUrl} 
        alt={video.title}
        loading="lazy"
        class="card-thumb-img transition-transform duration-500 ease-out group-hover:scale-105"
        onerror="this.src='https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?w=600&auto=format&fit=crop&q=80'"
      />

      <!-- Scrub progress indicator bar -->
      {hasPreview && (
        <div class="scrub-progress absolute bottom-0 left-0 h-0.5 bg-primary z-10 transition-all duration-75 opacity-0 group-hover:opacity-100" style="width: 0%;"></div>
      )}
      
      <!-- Category Badge Top Left -->
      <div class="video-card-badge top-2 left-2 !bg-slate-950/70 backdrop-blur-md border border-white/10 px-2 py-0.5 rounded-md shadow-sm">
        <span class="text-[10px] font-bold text-slate-200 uppercase tracking-wider">{video.category}</span>
      </div>

      <!-- Duration Badge Bottom Right -->
      <div class="video-card-badge bottom-2 right-2 font-mono !bg-slate-950/80 backdrop-blur-md border border-white/10 px-1.5 py-0.5 rounded-md shadow-sm">
        <span class="text-[11px] font-semibold text-white tracking-wide">{video.duration || '03:00'}</span>
      </div>

      <!-- Views / Trending Icon Bottom Left -->
      <div class="video-card-badge bottom-2 left-2 flex items-center gap-1.5 !bg-slate-950/80 backdrop-blur-md border border-white/10 px-2 py-0.5 rounded-md shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span class="text-[11px] font-medium text-slate-300">{formatNumber(video.views || 0)}</span>
      </div>
    </div>

    <!-- Title -->
    <h3 class="video-card-title text-[13px] sm:text-sm font-medium text-slate-200 group-hover:text-primary transition-colors leading-snug line-clamp-2">
      {video.title}
    </h3>
  </a>
</li>

