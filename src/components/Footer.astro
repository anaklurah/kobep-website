---
import { getDb } from '../lib/db';

const db = getDb();
const settings = db.settings;
---

<footer class="mt-12 py-10 border-t border-gray-800/80 bg-black text-gray-400 text-sm">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          {settings.logoUrl ? (
            <img src={settings.logoUrl} alt={settings.siteName} class="h-6 w-auto" />
          ) : null}
          <span class="text-white font-bold text-lg">{settings.siteName}</span>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed">
          {settings.tagline || 'Situs streaming video terbaru dan terlengkap dengan kualitas HD gratis. Update setiap hari.'}
        </p>
      </div>

      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Keunggulan Layanan</h4>
        <ul class="text-xs space-y-2 text-gray-400">
          <li class="flex items-center gap-2">
            <span class="text-primary font-bold">✓</span> Video Terkini Kualitas HD
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary font-bold">✓</span> Nonton Cepat Tanpa Buffering
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary font-bold">✓</span> Tampilan Mobile Friendly & Ringan
          </li>
          <li class="flex items-center gap-2">
            <span class="text-primary font-bold">✓</span> Interaksi Komentar Langsung
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Komunitas & Bantuan</h4>
        <p class="text-xs text-gray-400 mb-3">
          Bergabunglah dengan channel resmi kami untuk update konten terbaru setiap hari.
        </p>
        {settings.telegramLink && (
          <a 
            href={settings.telegramLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#229ED9]/20 text-[#229ED9] hover:bg-[#229ED9] hover:text-white transition-all text-xs font-semibold border border-[#229ED9]/30"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.61 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.05-.48-.83-.27-1.48-.42-1.42-.88.03-.24.37-.49 1.02-.75 4-1.74 6.68-2.88 8.03-3.44 3.83-1.58 4.63-1.85 5.15-1.86.11 0 .37.03.54.17.14.12.18.28.2.45-.01.07.01.22 0 .31z"/>
            </svg>
            <span>Gabung Channel Telegram</span>
          </a>
        )}
      </div>
    </div>

    <div class="pt-6 border-t border-gray-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>&copy; {new Date().getFullYear()} {settings.siteName}. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/" class="hover:text-gray-300 transition-colors">Home</a>
      </div>
    </div>
  </div>

  <!-- Floating Telegram Button -->
  {settings.telegramLink && (
    <a 
      href={settings.telegramLink} 
      target="_blank" 
      rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-50 flex items-center gap-2 bg-[#229ED9] hover:bg-[#1e8bc0] text-white px-3.5 py-2 rounded-full shadow-lg shadow-[#229ED9]/30 transition-all hover:scale-105"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.61 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.05-.48-.83-.27-1.48-.42-1.42-.88.03-.24.37-.49 1.02-.75 4-1.74 6.68-2.88 8.03-3.44 3.83-1.58 4.63-1.85 5.15-1.86.11 0 .37.03.54.17.14.12.18.28.2.45-.01.07.01.22 0 .31z"/>
      </svg>
      <span class="text-xs font-bold hidden sm:inline">Join Telegram</span>
    </a>
  )}
</footer>
