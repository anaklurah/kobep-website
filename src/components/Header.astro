---
import { getDb } from '../lib/db';
import SearchBar from './SearchBar.astro';

const db = getDb();
const settings = db.settings;
const categories = db.categories;
const currentQuery = Astro.url.searchParams.get('q') || Astro.url.searchParams.get('keyword') || '';
---

<header class="sticky top-0 z-40 bg-black/90 backdrop-blur-md border-b border-gray-800/80" role="navigation">
  <div class="container mx-auto px-4 py-2.5 md:py-3">
    <div class="flex flex-wrap items-center justify-between">
      <!-- Brand Logo & Name -->
      <a href="/" class="flex items-center space-x-2.5 group">
        {settings.logoUrl ? (
          <img src={settings.logoUrl} alt={settings.siteName} class="h-7 md:h-8 w-auto object-contain" />
        ) : (
          <div class="w-7 h-7 md:w-8 md:h-8 rounded-lg bg-primary flex items-center justify-center font-black text-white text-base md:text-lg">
            {settings.siteName.charAt(0)}
          </div>
        )}
        <span class="font-black text-lg md:text-xl tracking-tight text-white group-hover:text-primary transition-colors">
          {settings.siteName}
        </span>
      </a>

      <!-- Right Controls: Mobile Hamburger Toggle -->
      <div class="flex items-center gap-3 md:order-3">
        <!-- Mobile Hamburger Button -->
        <button 
          id="mobile-menu-toggle" 
          type="button" 
          class="inline-flex items-center p-2 w-9 h-9 justify-center text-sm rounded-lg md:hidden text-gray-400 hover:bg-gray-800 hover:text-white focus:outline-none"
          aria-controls="navbar-menu" 
          aria-expanded="false"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"></path>
          </svg>
        </button>
      </div>

      <!-- Navigation Menu (Categories) -->
      <nav class="hidden w-full md:flex md:w-auto md:order-2" id="navbar-menu">
        <ul class="flex flex-col p-4 md:p-0 mt-3 border border-gray-800 rounded-lg md:flex-row md:space-x-2 lg:space-x-5 rtl:space-x-reverse md:mt-0 md:border-0 bg-gray-950/95 md:bg-transparent items-stretch md:items-center">
          <li>
            <a href="/" class="text-xs lg:text-sm font-medium block py-1.5 px-2 lg:px-2.5 rounded text-gray-300 hover:text-primary transition-colors">
              Beranda
            </a>
          </li>
          <li>
            <a href="/trending" class="text-xs lg:text-sm font-medium flex items-center gap-1.5 py-1.5 px-2 lg:px-2.5 rounded text-amber-400 hover:text-amber-300 transition-colors">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
              </svg>
              <span>Trending</span>
            </a>
          </li>
          {categories.map((cat) => (
            <li>
              <a 
                href={`/category/${cat.slug}`} 
                class="text-xs lg:text-sm font-medium block py-1.5 px-2 lg:px-2.5 rounded text-gray-300 hover:text-primary transition-colors whitespace-nowrap"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile Search Bar: Only visible on mobile view (< md) inside Navbar -->
      <div class="w-full block md:hidden mt-2.5 pt-1 order-4">
        <SearchBar isMobileNavbar={true} initialQuery={currentQuery} />
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('navbar-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
