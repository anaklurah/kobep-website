---
import { getDb } from '../lib/db';

interface Props {
  initialQuery?: string;
  placeholder?: string;
  isMobileNavbar?: boolean;
  class?: string;
}

const { 
  initialQuery = '', 
  placeholder = 'Cari video, artis, atau kategori...',
  isMobileNavbar = false,
  class: className = ''
} = Astro.props;

const db = getDb();

// Default trending searches matching user's design reference
const defaultTrending = [
  'indo viral',
  'skandal artis',
  'cewek manado',
  'jilbab tobrut',
  'selebgram viral',
  'hotel bintang',
  'bokep jepang',
  'sub indo',
  'ngewe fisip',
  'desahan enak'
];

// Enrich with tags from database
const tagsSet = new Set<string>(defaultTrending);
db.videos.forEach((v) => {
  if (Array.isArray(v.tags)) {
    v.tags.forEach((t) => {
      if (t && t.trim()) tagsSet.add(t.trim().toLowerCase());
    });
  }
});
const trendingList = Array.from(tagsSet).slice(0, 10);

// Trending categories / models with circular avatar
const trendingCategories = db.categories.slice(0, 5).map((cat) => {
  const vid = db.videos.find(
    (v) =>
      v.category.toLowerCase() === cat.name.toLowerCase() ||
      v.category.toLowerCase() === cat.slug.toLowerCase()
  );
  return {
    name: cat.name,
    slug: cat.slug,
    thumb: vid?.thumbnail || '/uploads/logos/logo.png'
  };
});
---

<!-- Search Component Wrapper with Smooth Dropdown (Not Fullscreen) -->
<div 
  class={`smooth-search-container relative w-full z-40 ${isMobileNavbar ? 'my-0 px-0' : 'max-w-2xl mx-auto my-4 px-4'} ${className}`}
>
  <!-- Search Input Bar -->
  <form 
    action="/search" 
    method="GET" 
    class={`smooth-search-form relative flex items-center bg-[#111827] hover:bg-[#151d2d] border border-gray-800 focus-within:border-primary/80 focus-within:ring-1 focus-within:ring-primary/80 rounded-full transition-all shadow-lg ${isMobileNavbar ? 'px-3 py-1.5' : 'px-3.5 py-1.5'}`}
  >
    <!-- Magnifying Glass Icon -->
    <div class={`${isMobileNavbar ? 'pl-0.5 pr-2' : 'pl-1.5 pr-2.5'} flex items-center pointer-events-none text-gray-400`}>
      <svg class={`${isMobileNavbar ? 'w-3.5 h-3.5' : 'w-4 h-4'}`} xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </div>

    <!-- Main Text Input -->
    <input 
      type="text" 
      name="q" 
      value={initialQuery}
      placeholder={placeholder} 
      autocomplete="off"
      required
      class={`smooth-search-input w-full bg-transparent text-white focus:outline-none placeholder:text-gray-500 font-medium ${isMobileNavbar ? 'py-1 text-xs' : 'py-1.5 text-sm'}`}
    />

    <!-- Clear Text (X) Button -->
    <button 
      type="button" 
      class="smooth-clear-btn text-gray-400 hover:text-white p-1 rounded-full hidden transition-colors mr-1"
      title="Bersihkan"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Search Button -->
    <button 
      type="submit" 
      class={`bg-primary hover:bg-primary/90 text-white font-bold rounded-full shadow-md transition-all active:scale-95 shrink-0 ${isMobileNavbar ? 'px-3 py-1 text-xs' : 'px-4 py-1.5 text-xs'}`}
    >
      Cari
    </button>
  </form>

  <!-- Smooth Dropdown Menu (Directly Below Search Bar, Not Fullscreen) -->
  <div 
    class={`smooth-search-dropdown absolute top-full mt-2 bg-[#0d121d]/98 border border-gray-800/90 rounded-2xl shadow-2xl backdrop-blur-xl max-h-[70vh] overflow-y-auto space-y-4 md:space-y-5 transition-all duration-200 ease-out opacity-0 invisible translate-y-2 pointer-events-none z-50 scrollbar-thin scrollbar-thumb-gray-800 ${isMobileNavbar ? 'left-0 right-0 p-3.5' : 'left-4 right-4 p-4 md:p-5'}`}
  >
    <!-- 1. Recent Searches (if available) -->
    <div class="dropdown-recent-section hidden">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-xs md:text-base font-bold text-white tracking-tight">Recent Searches</h3>
        <button type="button" class="dropdown-clear-history-btn text-xs text-gray-500 hover:text-red-400 transition-colors">
          Clear all
        </button>
      </div>
      <div class="dropdown-recent-list space-y-0.5">
        <!-- Dynamically populated from localStorage -->
      </div>
    </div>

    <!-- 2. Trending Searches (Matches Screenshot Style) -->
    <div>
      <h3 class="text-xs md:text-base font-bold text-white tracking-tight mb-2">Trending Searches</h3>
      <div class="space-y-0.5">
        {trendingList.map((item) => (
          <a 
            href={`/search?q=${encodeURIComponent(item)}`}
            class="dropdown-search-link block text-xs md:text-sm text-gray-300 hover:text-white hover:translate-x-1 py-1 transition-all cursor-pointer font-normal"
            data-query={item}
          >
            {item}
          </a>
        ))}
      </div>
    </div>

    <!-- 3. Trending Pornstars and Models / Kategori (Matches Screenshot Style) -->
    <div>
      <h3 class="text-xs md:text-base font-bold text-white tracking-tight mb-2 md:mb-2.5">Trending Pornstars and Models</h3>
      <div class="space-y-2 md:space-y-2.5">
        {trendingCategories.map((cat) => (
          <a 
            href={`/category/${cat.slug}`}
            class="flex items-center gap-2.5 md:gap-3.5 group p-1 -mx-1 rounded-xl hover:bg-white/5 transition-colors"
          >
            <img 
              src={cat.thumb} 
              alt={cat.name} 
              class="w-9 h-9 md:w-12 md:h-12 rounded-full object-cover border border-gray-800 group-hover:border-primary transition-colors bg-gray-900 shrink-0" 
              onerror="this.style.opacity='0.5'"
            />
            <span class="text-xs md:text-sm font-semibold text-gray-200 group-hover:text-white transition-colors">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </div>

  </div>

</div>

<script is:inline>
  (function() {
    const STORAGE_KEY = 'stream_search_history';

    function getHistory() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveHistory(query) {
      if (!query || !query.trim()) return;
      const q = query.trim();
      let list = getHistory();
      list = list.filter(item => item.toLowerCase() !== q.toLowerCase());
      list.unshift(q);
      if (list.length > 8) list = list.slice(0, 8);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch (e) {}
      renderAllRecentSearches();
    }

    function removeHistoryItem(query) {
      let list = getHistory();
      list = list.filter(item => item.toLowerCase() !== query.toLowerCase());
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch (e) {}
      renderAllRecentSearches();
    }

    function clearAllHistory() {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch (e) {}
      renderAllRecentSearches();
    }

    function renderAllRecentSearches() {
      const list = getHistory();
      document.querySelectorAll('.smooth-search-container').forEach(container => {
        const recentSection = container.querySelector('.dropdown-recent-section');
        const recentList = container.querySelector('.dropdown-recent-list');
        if (!recentSection || !recentList) return;

        if (list.length === 0) {
          recentSection.classList.add('hidden');
          recentList.innerHTML = '';
          return;
        }

        recentSection.classList.remove('hidden');
        recentList.innerHTML = '';

        list.forEach(item => {
          const row = document.createElement('div');
          row.className = 'group flex items-center justify-between py-1 hover:text-white cursor-pointer transition-colors';

          const textLink = document.createElement('a');
          textLink.href = '/search?q=' + encodeURIComponent(item);
          textLink.className = 'text-xs md:text-sm text-gray-300 group-hover:text-white group-hover:translate-x-1 truncate flex-1 transition-all';
          textLink.textContent = item;
          textLink.addEventListener('click', () => {
            saveHistory(item);
          });

          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'text-gray-500 hover:text-red-400 p-1 rounded transition-colors ml-2';
          delBtn.title = 'Hapus';
          delBtn.innerHTML = `
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          `;
          delBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            removeHistoryItem(item);
          });

          row.appendChild(textLink);
          row.appendChild(delBtn);
          recentList.appendChild(row);
        });
      });
    }

    function openDropdown(container) {
      const dropdown = container.querySelector('.smooth-search-dropdown');
      if (!dropdown) return;
      renderAllRecentSearches();
      dropdown.classList.remove('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
      dropdown.classList.add('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
    }

    function closeDropdown(container) {
      const dropdown = container.querySelector('.smooth-search-dropdown');
      if (!dropdown) return;
      dropdown.classList.add('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
      dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
    }

    function closeAllDropdowns() {
      document.querySelectorAll('.smooth-search-container').forEach(closeDropdown);
    }

    function initContainers() {
      document.querySelectorAll('.smooth-search-container').forEach(container => {
        if (container.dataset.searchInitialized) return;
        container.dataset.searchInitialized = 'true';

        const form = container.querySelector('.smooth-search-form');
        const input = container.querySelector('.smooth-search-input');
        const clearBtn = container.querySelector('.smooth-clear-btn');
        const clearHistoryBtn = container.querySelector('.dropdown-clear-history-btn');

        function updateClearBtn() {
          if (!clearBtn || !input) return;
          if (input.value.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }

        if (input) {
          input.addEventListener('focus', () => openDropdown(container));
          input.addEventListener('click', () => openDropdown(container));
          input.addEventListener('input', updateClearBtn);
        }

        if (clearBtn && input) {
          clearBtn.addEventListener('click', () => {
            input.value = '';
            updateClearBtn();
            input.focus();
          });
        }

        if (form) {
          form.addEventListener('submit', function() {
            if (input && input.value) {
              saveHistory(input.value);
            }
          });
        }

        if (clearHistoryBtn) {
          clearHistoryBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            clearAllHistory();
          });
        }

        container.querySelectorAll('.dropdown-search-link').forEach(link => {
          link.addEventListener('click', function() {
            const q = this.getAttribute('data-query');
            if (q) saveHistory(q);
          });
        });

        updateClearBtn();
      });
    }

    // Global click outside to close dropdowns
    document.addEventListener('click', function(e) {
      document.querySelectorAll('.smooth-search-container').forEach(container => {
        if (!container.contains(e.target)) {
          closeDropdown(container);
        }
      });
    });

    // Global Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeAllDropdowns();
      }
    });

    // Auto-save search page query
    const urlParams = new URLSearchParams(window.location.search);
    const currentQ = urlParams.get('q') || urlParams.get('keyword');
    if (currentQ && currentQ.trim()) {
      saveHistory(currentQ.trim());
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initContainers();
        renderAllRecentSearches();
      });
    } else {
      initContainers();
      renderAllRecentSearches();
    }
  })();
</script>
